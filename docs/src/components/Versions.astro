---
import { getLatestRelease, getLatestSnapshot } from "@/utils/versions.ts";
import { releasePrefix } from "@/utils/links.ts";

interface Props {
    channel?: "release" | "snapshot";
}

const { channel = "release" } = Astro.props;
const prefix = releasePrefix(Astro.url.pathname);
const version =
    channel === "snapshot" ? await getLatestSnapshot(prefix) : await getLatestRelease(prefix);
---
<code>{version}</code>